<Project>
  <UsingTask TaskName="OpenApiGeneratorTask"
             AssemblyFile="$(MSBuildThisFileDirectory)../tasks/netstandard2.0/TeknixIT.OpenApiGenerator.Server.dll" />

  <Target Name="RunTeknixITOpenApiGenerator"
          BeforeTargets="CoreCompile"
          Condition="'@(OpenApiGeneratorServer)' != ''">

    <PropertyGroup>
      <_OpenApiOutputDir>$(IntermediateOutputPath)OpenApiGenerated\</_OpenApiOutputDir>
    </PropertyGroup>

    <MakeDir Directories="$(_OpenApiOutputDir)" />

    <OpenApiGeneratorTask
      OpenApiFiles="@(OpenApiGeneratorServer)"
      OutputDirectory="$(_OpenApiOutputDir)">
      <Output TaskParameter="GeneratedFiles" ItemName="_OpenApiGeneratedFiles" />
    </OpenApiGeneratorTask>

    <ItemGroup>
      <Compile Include="@(_OpenApiGeneratedFiles)" />
    </ItemGroup>
  </Target>
</Project>
